# CyberGuard AI Environment Variables
# Copy to .env and fill in your keys

# Google Gemini API Key (for Multimodal Vision & Audio Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Threat Intelligence APIs (Optional - Fallbacks provided if omitted)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here

# WhatsApp Bot Integration (Optional - Simulator available out-of-the-box)
# For Twilio WhatsApp:
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# For Meta WhatsApp Cloud API:
META_WHATSAPP_TOKEN=your_meta_system_user_token_here
META_VERIFY_TOKEN=cyberguard_verify_secret
SERVER_PUBLIC_URL=https://your-ngrok-or-domain.ngrok-free.app

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]